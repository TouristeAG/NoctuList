rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Volunteer-portal accounts (e-mail + password) never count as team members.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password';
    }

    function isPasswordAccount() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password';
    }

    function isPortalUser() {
      return isPasswordAccount() && request.auth.token.get('email_verified', false) == true;
    }

    function portalOn(orgId) {
      return firestore.exists(/databases/(default)/documents/orgs/$(orgId)/institutionSettings/volunteer_portal_enabled)
        && firestore.get(/databases/(default)/documents/orgs/$(orgId)/institutionSettings/volunteer_portal_enabled)
             .data.get('value', '') in ['true', true];
    }

    function googleAliasPath(orgId) {
      return /databases/(default)/documents/orgs/$(orgId)/portalGoogleAccounts/$(request.auth.uid);
    }

    function isGoogleAccount() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string;
    }

    // Storage rules may read at most 2 Firestore documents per evaluation, so the Google branches
    // below only check the alias written by staff (plus members or one setting). Unlike
    // firestore.rules they do not check the portal switch, the Google option or the domain list:
    // while the alias exists, the linked Google account keeps reading and replacing its own
    // volunteer's portal photo even if the option or its domain is turned off. The Firestore
    // rules still close the page and the PROFILE request that would use an upload.
    // A missing alias makes .data an error, which refuses the request.
    function googleAliasPhoto(orgId) {
      return firestore.get(googleAliasPath(orgId)).data.get('volunteerUid', '') + '.jpg';
    }

    function profilePhotosOn(orgId) {
      return firestore.exists(/databases/(default)/documents/orgs/$(orgId)/institutionSettings/profile_photos_enabled)
        && firestore.get(/databases/(default)/documents/orgs/$(orgId)/institutionSettings/profile_photos_enabled)
             .data.get('value', '') in ['true', true];
    }

    function signupFormPath(orgId, formId) {
      return /databases/(default)/documents/orgs/$(orgId)/volunteerSignupForms/$(formId);
    }

    function signupFormAcceptsPhoto(orgId, formId) {
      return firestore.exists(signupFormPath(orgId, formId))
        && firestore.get(signupFormPath(orgId, formId)).data.status == 'OPEN'
        && firestore.get(signupFormPath(orgId, formId)).data.get('photosEnabled', false) == true
        && request.time.toMillis()
             < asMillis(firestore.get(signupFormPath(orgId, formId)).data.expiresAtMillis);
    }

    function memberPath(orgId) {
      return /databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function isMember(orgId) {
      return isSignedIn() && firestore.exists(memberPath(orgId));
    }

    function photoRequestPath(orgId, requestId) {
      return /databases/(default)/documents/orgs/$(orgId)/photoRequests/$(requestId);
    }

    // Same digit-string tolerance as firestore.rules: desktop writes may store millis as text.
    function asMillis(value) {
      return value is number ? value :
        (value is string && value.matches('^[0-9]+([.][0-9]+)?$') ? float(value) : 0);
    }

    function photoRequestIsOpen(orgId, requestId) {
      return firestore.exists(photoRequestPath(orgId, requestId))
        && firestore.get(photoRequestPath(orgId, requestId)).data.status == 'OPEN'
        && request.time.toMillis()
             < asMillis(firestore.get(photoRequestPath(orgId, requestId)).data.expiresAtMillis);
    }

    // Public profile-photo upload: no account, one JPEG per open request. The app copies it into
    // profilePhotos/ and then deletes it, so members may read and delete.
    match /orgs/{orgId}/photoRequests/{fileName} {
      allow read, delete: if isMember(orgId);
      allow create, update: if fileName.matches('^[A-Za-z0-9_-]{10,64}[.]jpg$')
        && photoRequestIsOpen(orgId, fileName.split('[.]')[0])
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // Optional photo picked on the volunteer registration page (/s/). The person has just created
    // their portal account; the app imports the photo onto the new profile and deletes it.
    match /orgs/{orgId}/portalSignupPhotos/{fileName} {
      allow read, delete: if isMember(orgId);
      allow create, update: if isPasswordAccount()
        && portalOn(orgId)
        && fileName.matches('^[A-Za-z0-9_-]{10,64}[.]jpg$')
        && signupFormAcceptsPhoto(orgId, fileName.split('[.]')[0])
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // New photo picked by a volunteer in their portal space, sent along with a PROFILE request.
    // Keyed by the portal account id; the server (or a device) moves it onto the profile and
    // deletes it, so the volunteer may only write their own file and never read it back.
    match /orgs/{orgId}/portalPhotoUploads/{fileName} {
      allow read, delete: if isMember(orgId);
      allow create, update: if (
          (isPortalUser()
            && portalOn(orgId)
            && profilePhotosOn(orgId)
            && fileName == request.auth.uid + '.jpg')
          || (isGoogleAccount()
            && profilePhotosOn(orgId)
            && fileName == googleAliasPhoto(orgId))
        )
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // Copy of a volunteer's profile photo published by the app for the portal, keyed by the portal
    // account id — never by the volunteer id, which doubles as the wallet QR code.
    match /orgs/{orgId}/portalPhotos/{fileName} {
      allow read: if isMember(orgId)
        // isPortalUser() first: a Google session must not spend a read on the portal switch.
        || (isPortalUser() && portalOn(orgId) && fileName == request.auth.uid + '.jpg')
        || (isGoogleAccount() && fileName == googleAliasPhoto(orgId));
      allow create, update: if isMember(orgId)
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if isMember(orgId);
    }

    match /orgs/{orgId}/profilePhotos/{kind}/{fileName} {
      allow read: if isMember(orgId)
        && kind in ['guests', 'volunteers'];
      // Delete has no request.resource — a single `write` rule with size/type checks
      // would deny Remove even for org members.
      allow create, update: if isMember(orgId)
        && kind in ['guests', 'volunteers']
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if isMember(orgId)
        && kind in ['guests', 'volunteers'];
    }
  }
}
