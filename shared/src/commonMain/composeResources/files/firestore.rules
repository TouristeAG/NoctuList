rules_version = '2';
// NoctuList Firestore rules — NOCTULIST_RULES_VERSION = 15
// Republish this exact file in Firebase Console → Firestore → Rules after every app update,
// otherwise members that already exist cannot re-join their organization.
service cloud.firestore {
  match /databases/{database}/documents {

    // Team devices sign in with Google. Volunteer-portal accounts (e-mail + password) must never
    // count as signed-in staff: they cannot join, bootstrap or read an organization.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password';
    }

    function isPasswordAccount() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password';
    }

    // A volunteer-portal session: e-mail + password account whose address has been verified.
    function isPortalUser() {
      return isPasswordAccount()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string;
    }

    // Server-side kill switch: the whole volunteer portal is off unless an org admin turned it on.
    function portalOn(orgId) {
      return exists(/databases/$(database)/documents/orgs/$(orgId)/institutionSettings/volunteer_portal_enabled)
        && get(/databases/$(database)/documents/orgs/$(orgId)/institutionSettings/volunteer_portal_enabled)
             .data.get('value', '') in ['true', true];
    }

    function settingPath(orgId, key) {
      return /databases/$(database)/documents/orgs/$(orgId)/institutionSettings/$(key);
    }

    function googleAliasPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/portalGoogleAccounts/$(request.auth.uid);
    }

    // Second switch, under the portal one: volunteers may also sign in with an association
    // Google account.
    function portalGoogleOn(orgId) {
      let path = settingPath(orgId, 'volunteer_portal_google_enabled');
      return portalOn(orgId)
        && exists(path)
        && get(path).data.get('value', '') in ['true', true];
    }

    // A Google sign-in with a verified address. This alone grants nothing: staff rights still
    // need a members/{uid} document, portal rights an alias written by staff.
    function isGoogleAccount() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string;
    }

    // The address belongs to one of the association's verified domains (comma-separated list).
    function portalGoogleDomainOk(orgId) {
      let path = settingPath(orgId, 'volunteer_portal_google_domains');
      let domain = authEmailDomain();
      return domain.size() > 0
        && exists(path)
        && get(path).data.get('value', '') is string
        && domain in get(path).data.value.split(',');
    }

    // A Google account that staff linked to one volunteer (portalGoogleAccounts/{googleUid}).
    function isPortalGoogleUser(orgId) {
      return isGoogleAccount()
        && portalGoogleOn(orgId)
        && portalGoogleDomainOk(orgId)
        && exists(googleAliasPath(orgId));
    }

    // The portal account the session acts for: its own uid for a password session, the linked
    // volunteer's portal uid for a Google session. Only call after isPortalUser() or
    // isPortalGoogleUser(orgId) holds.
    function portalUidOf(orgId) {
      return isPortalUser() ? request.auth.uid : get(googleAliasPath(orgId)).data.volunteerUid;
    }

    function validPersonName(value) {
      return value is string
        && value.trim().size() > 0
        && value.matches('^[^<>{}\\\\]{1,60}$');
    }

    function validPhone(value) {
      return value is string && value.matches('^[0-9+() .-]{4,32}$');
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function configPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/metadata/config;
    }

    function authEmailDomain() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower().split('@')[1]
        : '';
    }

    function emailDomainAllowed(orgId) {
      return !exists(configPath(orgId))
        || !('allowedEmailDomains' in get(configPath(orgId)).data)
        // A non-map value would make keys() below an evaluation error, which denies every write.
        || !(get(configPath(orgId)).data.allowedEmailDomains is map)
        || get(configPath(orgId)).data.allowedEmailDomains.keys().size() == 0
        || (
          authEmailDomain().size() > 0
          && authEmailDomain() in get(configPath(orgId)).data.allowedEmailDomains
          && get(configPath(orgId)).data.allowedEmailDomains[authEmailDomain()] == true
        );
    }

    function isMember(orgId) {
      return isSignedIn()
        && exists(memberPath(orgId))
        && emailDomainAllowed(orgId);
    }

    function memberRole(orgId) {
      return get(memberPath(orgId)).data.role;
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && memberRole(orgId) == 'admin';
    }

    function guestFormParentPath(orgId, parentFormId) {
      return /databases/$(database)/documents/orgs/$(orgId)/guestForms/$(parentFormId);
    }

    // GitLive on desktop sometimes stores millis as a digit string. `is number` then denies
    // the anonymous get, and the public page looks "closed". Accept both encodings.
    function asMillis(value) {
      return value is number ? value :
        (value is string && value.matches('^[0-9]+([.][0-9]+)?$') ? float(value) : 0);
    }

    function guestFormIsOpen(data) {
      return data.status == 'OPEN'
        && request.time.toMillis() < asMillis(data.expiresAtMillis);
    }

    // Multi-response answers spawn a new PENDING_REVIEW doc; the open template must still
    // accept answers (OPEN, flagged, unexpired) and the child must copy venue/event fields.
    function isPublicMultiGuestFormCreate(orgId, formId) {
      return request.resource.data.parentFormId is string
        && request.resource.data.parentFormId.size() > 0
        && exists(guestFormParentPath(orgId, request.resource.data.parentFormId))
        && guestFormIsOpen(get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data)
        && get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.allowMultipleResponses == true
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.formId == formId
        && request.resource.data.submissionJson is string
        && request.resource.data.submissionJson.size() < 20000
        && request.resource.data.venueName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.venueName
        && request.resource.data.eventName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.eventName
        && request.resource.data.eventDateMillis
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.eventDateMillis
        && request.resource.data.artistName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.artistName
        && request.resource.data.offeredAccessIds
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.offeredAccessIds
        && request.resource.data.maxGuests
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.maxGuests
        && request.resource.data.expiresAtMillis
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.expiresAtMillis
        && (
             !('institutionLogoDataUri' in request.resource.data)
             || request.resource.data.institutionLogoDataUri == ''
           )
        && (
             !('guestLogoDataUri' in request.resource.data)
             || request.resource.data.guestLogoDataUri == ''
           )
        && (
             !('sourceDeviceId' in request.resource.data)
             || request.resource.data.sourceDeviceId == ''
           )
        && (
             !('allowMultipleResponses' in request.resource.data)
             || request.resource.data.allowMultipleResponses == false
           );
    }

    function isValidMemberRole(role) {
      return role in ['admin', 'member', 'door', 'pos'];
    }

    function legacyMemberRole(role) {
      return role in ['member', 'door', 'pos'];
    }

    function configBootstrapSecret(orgId) {
      return exists(configPath(orgId))
        && (
          ('bootstrapCodeHash' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCodeHash.size() > 0)
          || ('bootstrapCode' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCode.size() > 0)
        )
        ? (
          ('bootstrapCodeHash' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCodeHash.size() > 0)
            ? get(configPath(orgId)).data.bootstrapCodeHash
            : get(configPath(orgId)).data.bootstrapCode
        )
        : '';
    }

    function purchaseBufferPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/institutionSettings/purchase_credit_buffer;
    }

    // A brand-new org has no purchase_credit_buffer document yet, and get() on a missing document
    // returns null — reading .data off it is an evaluation error that denies every accounts write.
    function purchaseBufferValue(orgId) {
      return (exists(purchaseBufferPath(orgId))
        && ('value' in get(purchaseBufferPath(orgId)).data))
        ? get(purchaseBufferPath(orgId)).data.value
        : 0.0;
    }

    // An unset or malformed buffer means "no overdraft", never a blanket denial.
    function purchaseBuffer(orgId) {
      let value = purchaseBufferValue(orgId);
      return value is number ? value :
        (value is string && value.matches('^-?[0-9]+([.][0-9]+)?$') ? float(value) : 0.0);
    }

    function isAdminFieldUnchanged() {
      return !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /orgs/{orgId}/metadata/{docId} {
      allow read: if isMember(orgId);
      // Only the first admin (who already created their own member doc) may seed the config.
      allow create: if isSignedIn()
        && !exists(configPath(orgId))
        && exists(memberPath(orgId));
      allow update: if isOrgAdmin(orgId);
    }

    match /orgs/{orgId}/members/{uid} {
      // Reading your own doc is always allowed so a device can tell "not a member" from
      // "denied" — otherwise it cannot decide between bootstrapping and joining.
      allow get: if isSignedIn()
        && (request.auth.uid == uid || isMember(orgId));
      allow list: if isMember(orgId);
      allow create: if isSignedIn()
        && emailDomainAllowed(orgId)
        && isValidMemberRole(request.resource.data.role)
        && (
          // First admin of a brand-new org only: once metadata/config exists nobody can
          // self-promote to admin, even without an existing member doc.
          (request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && !exists(configPath(orgId)))
          || (request.auth.uid == uid
            && legacyMemberRole(request.resource.data.role)
            && configBootstrapSecret(orgId).size() > 0
            && request.resource.data.bootstrapCode == configBootstrapSecret(orgId))
          || isOrgAdmin(orgId)
        );
      allow update: if isValidMemberRole(request.resource.data.role)
        && (
          // An org admin may change any *other* member's role (promote / demote / invite).
          // Self-updates go through the idempotent path below, which enforces role-unchanged.
          // This prevents a rogue join flow on a new device from silently demoting an admin:
          // joinOrgAsMember writes role=member, and isOrgAdmin() would otherwise allow it
          // because the member doc still says admin at write time.
          (isOrgAdmin(orgId) && request.auth.uid != uid)
          // Idempotent re-join: any member (including admins) may refresh their own doc as
          // long as the role is unchanged. Required after a factory reset / re-install because
          // set(merge: true) on an existing doc is an update, not a create.
          || (request.auth.uid == uid
            && emailDomainAllowed(orgId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['email', 'updatedAt', 'json', 'bootstrapCode']))
        );
      allow delete: if isOrgAdmin(orgId);
    }

    match /orgs/{orgId}/transfers/{transferId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId);
      allow update, delete: if false;
    }

    match /orgs/{orgId}/accounts/{holderKey} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId)
        && request.resource.data.balance >= (0.0 - purchaseBuffer(orgId));
    }

    match /orgs/{orgId}/guests/{docId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId)
        && (isOrgAdmin(orgId) || request.resource.data.isAdmin != true);
      allow update: if isMember(orgId)
        && (isOrgAdmin(orgId) || isAdminFieldUnchanged());
      allow delete: if isMember(orgId);
    }

    match /orgs/{orgId}/jobs/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/salesItems/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/volunteers/{docId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId)
        && (isOrgAdmin(orgId) || request.resource.data.isAdmin != true);
      allow update: if isMember(orgId)
        && (isOrgAdmin(orgId) || isAdminFieldUnchanged());
      allow delete: if isMember(orgId);
    }

    match /orgs/{orgId}/jobTypeConfigs/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/venues/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/institutionSettings/{key} {
      allow read: if isMember(orgId);
      allow write: if isOrgAdmin(orgId);
    }

    // Artist guest list forms. The only unauthenticated surface in this database: an artist
    // opens a link holding the form's NanoID and fills in their guest list without an account.
    match /orgs/{orgId}/guestForms/{formId} {
      allow read, write: if isMember(orgId);

      // Public read is a targeted get only — never list — so a form is unreachable without its
      // exact ID, and only while it is still open and unexpired.
      allow get: if guestFormIsOpen(resource.data);

      // Multi-response: each answer creates a new PENDING_REVIEW doc; the template stays OPEN.
      allow create: if isPublicMultiGuestFormCreate(orgId, formId);

      // Single-response: answer in place and move to PENDING_REVIEW (closes public get).
      // Multi-response templates must not be closed this way — use create above instead.
      // Clearing sourceDeviceId is required so the device that created the form does not treat
      // the artist answer as its own write echo and drop it.
      allow update: if guestFormIsOpen(resource.data)
        && resource.data.get('allowMultipleResponses', false) != true
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'submissionJson', 'submittedAt', 'lastModified', 'sourceDeviceId'])
        && request.resource.data.submissionJson is string
        && request.resource.data.submissionJson.size() < 20000
        && (
             !('sourceDeviceId' in request.resource.data)
             || request.resource.data.sourceDeviceId == ''
           );
    }

    function photoRequestIsOpen(data) {
      return data.status == 'OPEN'
        && request.time.toMillis() < asMillis(data.expiresAtMillis);
    }

    // Profile photo requests. A guest or volunteer opens /p/{orgId}/{requestId} without an
    // account, uploads one JPEG to Storage, then flips the request to UPLOADED. The app picks the
    // photo up, stores it on the profile and deletes the request.
    match /orgs/{orgId}/photoRequests/{requestId} {
      allow read, write: if isMember(orgId);

      // Targeted get only (never list), and only while the request is open and unexpired.
      allow get: if photoRequestIsOpen(resource.data);

      allow update: if photoRequestIsOpen(resource.data)
        && request.resource.data.status == 'UPLOADED'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'photoPath', 'uploadedAt', 'lastModified'])
        && request.resource.data.photoPath
             == 'orgs/' + orgId + '/photoRequests/' + requestId + '.jpg';
    }

    // ---------------------------------------------------------------------------------------
    // Volunteer portal (public site /s/ and /v/). Members reach these collections through the
    // catch-all below; everything here is the *only* access a portal account or visitor gets.
    // ---------------------------------------------------------------------------------------

    function signupFormIsOpen(data) {
      return data.status == 'OPEN'
        && request.time.toMillis() < asMillis(data.expiresAtMillis);
    }

    function validSignupSubmission(orgId, formId) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
          'status', 'submittedUid', 'email', 'firstName', 'lastName', 'phone', 'dateOfBirth',
          'gender', 'photoPath', 'consent', 'lang', 'submittedAt', 'lastModified'])
        && d.status == 'SUBMITTED'
        && d.submittedUid == request.auth.uid
        && d.email is string
        && d.email == request.auth.token.get('email', '')
        && validPersonName(d.firstName)
        && validPersonName(d.lastName)
        && validPhone(d.phone)
        && d.dateOfBirth is string
        && d.dateOfBirth.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.gender in ['FEMALE', 'MALE', 'NON_BINARY', 'OTHER', 'PREFER_NOT_TO_DISCLOSE']
        && (d.photoPath == ''
          || (resource.data.get('photosEnabled', false) == true
            && d.photoPath == 'orgs/' + orgId + '/portalSignupPhotos/' + formId + '.jpg'))
        && d.consent == true
        && d.lang in ['fr', 'en', 'es', 'de', 'it']
        && d.submittedAt == request.time
        && d.lastModified is number;
    }

    // One single-use registration link per volunteer, created by the app. Targeted get only.
    match /orgs/{orgId}/volunteerSignupForms/{formId} {
      allow get: if portalOn(orgId) && signupFormIsOpen(resource.data);
      allow update: if portalOn(orgId)
        && isPasswordAccount()
        && signupFormIsOpen(resource.data)
        && validSignupSubmission(orgId, formId);
    }

    // Public branding of the portal login page (association name + logo). Nothing personal.
    match /orgs/{orgId}/portalBranding/{docId} {
      allow get: if portalOn(orgId) && docId == 'default';
    }

    // The filtered projection the app publishes for one volunteer. Only its owner may read it.
    match /orgs/{orgId}/volunteerPortal/{uid} {
      allow get: if portalOn(orgId)
        && (
          (isPortalUser() && request.auth.uid == uid)
          || (isPortalGoogleUser(orgId) && portalUidOf(orgId) == uid)
        );
    }

    function portalRequestDelayMinutes(type) {
      return type == 'QR_EMAIL' ? 10 : 1;
    }

    // Only call after isPortalUser() or isPortalGoogleUser(orgId) holds.
    function validPortalRequest(orgId, requestId) {
      let d = request.resource.data;
      return d.uid == portalUidOf(orgId)
        && d.type in ['PROFILE', 'QR_EMAIL', 'CLAIM', 'GOOGLE_LINK', 'GOOGLE_UNLINK']
        && requestId == d.uid + '_' + d.type
        // Claiming a profile and linking a Google account need the password session.
        && (!(d.type in ['CLAIM', 'GOOGLE_LINK']) || isPortalUser())
        && d.status == 'PENDING'
        && d.requestedAt == request.time
        && d.email == request.auth.token.get('email', '')
        && (
          (d.type == 'PROFILE'
            && d.keys().hasOnly(['uid', 'type', 'status', 'requestedAt', 'email', 'firstName', 'lastName', 'phone', 'photo'])
            // photo: a new picture waits in portalPhotoUploads/{uid}.jpg.
            && d.get('photo', true) == true
            && validPersonName(d.firstName)
            && validPersonName(d.lastName)
            && validPhone(d.phone))
          || (d.type == 'GOOGLE_LINK'
            && d.keys().hasOnly(['uid', 'type', 'status', 'requestedAt', 'email', 'codeHash'])
            && d.codeHash is string
            && d.codeHash.matches('^[0-9a-f]{64}$'))
          || (d.type in ['QR_EMAIL', 'CLAIM', 'GOOGLE_UNLINK']
            && d.keys().hasOnly(['uid', 'type', 'status', 'requestedAt', 'email']))
        );
    }

    // Requests from a portal account: one document per account and type, so a single request can
    // be pending at a time, and renewals are throttled server-side. A linked Google session acts
    // for its volunteer's portal account and shares these documents.
    match /orgs/{orgId}/portalRequests/{requestId} {
      allow get: if (isPortalUser() || isPortalGoogleUser(orgId))
        && requestId in [
          portalUidOf(orgId) + '_PROFILE',
          portalUidOf(orgId) + '_QR_EMAIL',
          portalUidOf(orgId) + '_CLAIM',
          portalUidOf(orgId) + '_GOOGLE_LINK',
          portalUidOf(orgId) + '_GOOGLE_UNLINK'
        ];
      allow create: if portalOn(orgId)
        && (isPortalUser() || isPortalGoogleUser(orgId))
        && validPortalRequest(orgId, requestId);
      allow update: if portalOn(orgId)
        && (isPortalUser() || isPortalGoogleUser(orgId))
        && resource.data.uid == portalUidOf(orgId)
        // A claim older than 5 minutes was abandoned: the volunteer may send the request again.
        && (resource.data.status != 'PROCESSING'
             || request.time.toMillis() > resource.data.processingAt + 300000)
        && validPortalRequest(orgId, requestId)
        && request.time > resource.data.requestedAt
             + duration.value(portalRequestDelayMinutes(request.resource.data.type), 'm');
    }

    function canSendGoogleClaim(orgId, googleUid) {
      return isGoogleAccount()
        && request.auth.uid == googleUid
        && portalGoogleOn(orgId)
        && portalGoogleDomainOk(orgId);
    }

    function validGoogleClaim() {
      let d = request.resource.data;
      return d.type in ['ADMIN_MATCH', 'LINK_CODE']
        && d.status == 'PENDING'
        && d.requestedAt == request.time
        && d.email == request.auth.token.email
        && (
          (d.type == 'ADMIN_MATCH'
            && d.keys().hasOnly(['type', 'status', 'requestedAt', 'email']))
          || (d.type == 'LINK_CODE'
            && d.keys().hasOnly(['type', 'status', 'requestedAt', 'email', 'code'])
            && d.code is string
            && d.code.matches('^[A-Za-z0-9_-]{32,64}$'))
        );
    }

    // A Google account asking to be linked to a volunteer: by a one-time code from the
    // volunteer's password session, or by staff matching its address. Keyed by the Google uid,
    // one claim at a time; staff and the Functions process it (catch-all below).
    match /orgs/{orgId}/portalGoogleClaims/{googleUid} {
      allow get: if isGoogleAccount() && request.auth.uid == googleUid;
      allow create: if canSendGoogleClaim(orgId, googleUid) && validGoogleClaim();
      allow update: if canSendGoogleClaim(orgId, googleUid)
        && (resource.data.status != 'PROCESSING'
             || request.time.toMillis() > resource.data.processingAt + 300000)
        && validGoogleClaim()
        && request.time > resource.data.requestedAt + duration.value(1, 'm');
    }

    // Link from a Google account to a volunteer's portal account. Its owner may read it to know
    // whether it is linked; only members (catch-all below) and the Functions write it.
    match /orgs/{orgId}/portalGoogleAccounts/{googleUid} {
      allow get: if isGoogleAccount() && request.auth.uid == googleUid;
    }

    // E-mail template the devices publish for the Cloud Functions that mail volunteers.
    match /orgs/{orgId}/portalMail/{docId} {
      allow read, write: if isMember(orgId);
    }

    // QR e-mails a team device hands to the Cloud Functions when it has no Gmail account of its
    // own (SiteMailRelay). Only the server answers (Admin SDK); the device reads the answer and
    // deletes the document.
    match /orgs/{orgId}/mailOutbox/{mailId} {
      allow get, delete: if isMember(orgId);
      allow create: if isMember(orgId)
        && request.resource.data.keys().hasOnly(['schema', 'status', 'to', 'raw', 'fromName', 'createdBy', 'createdAt'])
        && request.resource.data.schema == 1
        && request.resource.data.status == 'PENDING'
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() <= 254
        && request.resource.data.raw is string
        && request.resource.data.raw.size() > 0
        && request.resource.data.raw.size() <= 900000
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // Presence document written by the Cloud Functions (Admin SDK bypasses rules). Members only read it.
    match /orgs/{orgId}/portalServer/{docId} {
      allow read: if isMember(orgId);
      allow write: if false;
    }

    match /orgs/{orgId}/{document=**} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId)
        && document[0] != 'transfers'
        && document[0] != 'members'
        && document[0] != 'metadata'
        && document[0] != 'institutionSettings'
        && document[0] != 'portalServer'
        && document[0] != 'mailOutbox';
    }
  }
}
