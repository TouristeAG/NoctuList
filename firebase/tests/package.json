{
  "name": "noctulist-firebase-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules tests and local preview for the NoctuList public pages (Firebase emulators only).",
  "scripts": {
    "test": "./emulators.sh emulators:exec --only auth,firestore,storage \"node --test --test-concurrency=1 rules/*.test.mjs\"",
    "preview": "./emulators.sh emulators:start --only auth,firestore,storage,hosting",
    "seed": "node seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
