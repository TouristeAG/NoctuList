rules_version = '2';
// NoctuList Firestore rules — NOCTULIST_RULES_VERSION = 9
// Republish this exact file in Firebase Console → Firestore → Rules after every app update,
// otherwise members that already exist cannot re-join their organization.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function configPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/metadata/config;
    }

    function authEmailDomain() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower().split('@')[1]
        : '';
    }

    function emailDomainAllowed(orgId) {
      return !exists(configPath(orgId))
        || !('allowedEmailDomains' in get(configPath(orgId)).data)
        // A non-map value would make keys() below an evaluation error, which denies every write.
        || !(get(configPath(orgId)).data.allowedEmailDomains is map)
        || get(configPath(orgId)).data.allowedEmailDomains.keys().size() == 0
        || (
          authEmailDomain().size() > 0
          && authEmailDomain() in get(configPath(orgId)).data.allowedEmailDomains
          && get(configPath(orgId)).data.allowedEmailDomains[authEmailDomain()] == true
        );
    }

    function isMember(orgId) {
      return isSignedIn()
        && exists(memberPath(orgId))
        && emailDomainAllowed(orgId);
    }

    function memberRole(orgId) {
      return get(memberPath(orgId)).data.role;
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && memberRole(orgId) == 'admin';
    }

    function guestFormParentPath(orgId, parentFormId) {
      return /databases/$(database)/documents/orgs/$(orgId)/guestForms/$(parentFormId);
    }

    // Multi-response answers spawn a new PENDING_REVIEW doc; the open template must still
    // accept answers (OPEN, flagged, unexpired) and the child must copy venue/event fields.
    function isPublicMultiGuestFormCreate(orgId, formId) {
      return request.resource.data.parentFormId is string
        && request.resource.data.parentFormId.size() > 0
        && exists(guestFormParentPath(orgId, request.resource.data.parentFormId))
        && get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.status == 'OPEN'
        && get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.allowMultipleResponses == true
        && get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.expiresAtMillis is number
        && request.time.toMillis()
             < get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.expiresAtMillis
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.formId == formId
        && request.resource.data.submissionJson is string
        && request.resource.data.submissionJson.size() < 20000
        && request.resource.data.venueName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.venueName
        && request.resource.data.eventName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.eventName
        && request.resource.data.eventDateMillis
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.eventDateMillis
        && request.resource.data.artistName
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.artistName
        && request.resource.data.offeredAccessIds
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.offeredAccessIds
        && request.resource.data.maxGuests
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.maxGuests
        && request.resource.data.expiresAtMillis
             == get(guestFormParentPath(orgId, request.resource.data.parentFormId)).data.expiresAtMillis
        && (
             !('institutionLogoDataUri' in request.resource.data)
             || request.resource.data.institutionLogoDataUri == ''
           )
        && (
             !('guestLogoDataUri' in request.resource.data)
             || request.resource.data.guestLogoDataUri == ''
           )
        && (
             !('sourceDeviceId' in request.resource.data)
             || request.resource.data.sourceDeviceId == ''
           )
        && (
             !('allowMultipleResponses' in request.resource.data)
             || request.resource.data.allowMultipleResponses == false
           );
    }

    function isValidMemberRole(role) {
      return role in ['admin', 'member', 'door', 'pos'];
    }

    function legacyMemberRole(role) {
      return role in ['member', 'door', 'pos'];
    }

    function configBootstrapSecret(orgId) {
      return exists(configPath(orgId))
        && (
          ('bootstrapCodeHash' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCodeHash.size() > 0)
          || ('bootstrapCode' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCode.size() > 0)
        )
        ? (
          ('bootstrapCodeHash' in get(configPath(orgId)).data
            && get(configPath(orgId)).data.bootstrapCodeHash.size() > 0)
            ? get(configPath(orgId)).data.bootstrapCodeHash
            : get(configPath(orgId)).data.bootstrapCode
        )
        : '';
    }

    function purchaseBufferPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/institutionSettings/purchase_credit_buffer;
    }

    // A brand-new org has no purchase_credit_buffer document yet, and get() on a missing document
    // returns null — reading .data off it is an evaluation error that denies every accounts write.
    function purchaseBufferValue(orgId) {
      return (exists(purchaseBufferPath(orgId))
        && ('value' in get(purchaseBufferPath(orgId)).data))
        ? get(purchaseBufferPath(orgId)).data.value
        : 0.0;
    }

    // An unset or malformed buffer means "no overdraft", never a blanket denial.
    function purchaseBuffer(orgId) {
      let value = purchaseBufferValue(orgId);
      return value is number ? value :
        (value is string && value.matches('^-?[0-9]+([.][0-9]+)?$') ? float(value) : 0.0);
    }

    function isAdminFieldUnchanged() {
      return !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /orgs/{orgId}/metadata/{docId} {
      allow read: if isMember(orgId);
      // Only the first admin (who already created their own member doc) may seed the config.
      allow create: if isSignedIn()
        && !exists(configPath(orgId))
        && exists(memberPath(orgId));
      allow update: if isOrgAdmin(orgId);
    }

    match /orgs/{orgId}/members/{uid} {
      // Reading your own doc is always allowed so a device can tell "not a member" from
      // "denied" — otherwise it cannot decide between bootstrapping and joining.
      allow get: if isSignedIn()
        && (request.auth.uid == uid || isMember(orgId));
      allow list: if isMember(orgId);
      allow create: if isSignedIn()
        && emailDomainAllowed(orgId)
        && isValidMemberRole(request.resource.data.role)
        && (
          // First admin of a brand-new org only: once metadata/config exists nobody can
          // self-promote to admin, even without an existing member doc.
          (request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && !exists(configPath(orgId)))
          || (request.auth.uid == uid
            && legacyMemberRole(request.resource.data.role)
            && configBootstrapSecret(orgId).size() > 0
            && request.resource.data.bootstrapCode == configBootstrapSecret(orgId))
          || isOrgAdmin(orgId)
        );
      allow update: if isValidMemberRole(request.resource.data.role)
        && (
          // An org admin may change any *other* member's role (promote / demote / invite).
          // Self-updates go through the idempotent path below, which enforces role-unchanged.
          // This prevents a rogue join flow on a new device from silently demoting an admin:
          // joinOrgAsMember writes role=member, and isOrgAdmin() would otherwise allow it
          // because the member doc still says admin at write time.
          (isOrgAdmin(orgId) && request.auth.uid != uid)
          // Idempotent re-join: any member (including admins) may refresh their own doc as
          // long as the role is unchanged. Required after a factory reset / re-install because
          // set(merge: true) on an existing doc is an update, not a create.
          || (request.auth.uid == uid
            && emailDomainAllowed(orgId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['email', 'updatedAt', 'json', 'bootstrapCode']))
        );
      allow delete: if isOrgAdmin(orgId);
    }

    match /orgs/{orgId}/transfers/{transferId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId);
      allow update, delete: if false;
    }

    match /orgs/{orgId}/accounts/{holderKey} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId)
        && request.resource.data.balance >= (0.0 - purchaseBuffer(orgId));
    }

    match /orgs/{orgId}/guests/{docId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId)
        && (isOrgAdmin(orgId) || request.resource.data.isAdmin != true);
      allow update: if isMember(orgId)
        && (isOrgAdmin(orgId) || isAdminFieldUnchanged());
      allow delete: if isMember(orgId);
    }

    match /orgs/{orgId}/jobs/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/salesItems/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/volunteers/{docId} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId)
        && (isOrgAdmin(orgId) || request.resource.data.isAdmin != true);
      allow update: if isMember(orgId)
        && (isOrgAdmin(orgId) || isAdminFieldUnchanged());
      allow delete: if isMember(orgId);
    }

    match /orgs/{orgId}/jobTypeConfigs/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/venues/{docId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);
    }

    match /orgs/{orgId}/institutionSettings/{key} {
      allow read: if isMember(orgId);
      allow write: if isOrgAdmin(orgId);
    }

    // Artist guest list forms. The only unauthenticated surface in this database: an artist
    // opens a link holding the form's NanoID and fills in their guest list without an account.
    match /orgs/{orgId}/guestForms/{formId} {
      allow read, write: if isMember(orgId);

      // Public read is a targeted get only — never list — so a form is unreachable without its
      // exact ID, and only while it is still open and unexpired.
      allow get: if resource.data.status == 'OPEN'
        && resource.data.expiresAtMillis is number
        && request.time.toMillis() < resource.data.expiresAtMillis;

      // Multi-response: each answer creates a new PENDING_REVIEW doc; the template stays OPEN.
      allow create: if isPublicMultiGuestFormCreate(orgId, formId);

      // Single-response: answer in place and move to PENDING_REVIEW (closes public get).
      // Multi-response templates must not be closed this way — use create above instead.
      // Clearing sourceDeviceId is required so the device that created the form does not treat
      // the artist answer as its own write echo and drop it.
      allow update: if resource.data.status == 'OPEN'
        && resource.data.get('allowMultipleResponses', false) != true
        && resource.data.expiresAtMillis is number
        && request.time.toMillis() < resource.data.expiresAtMillis
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'submissionJson', 'submittedAt', 'lastModified', 'sourceDeviceId'])
        && request.resource.data.submissionJson is string
        && request.resource.data.submissionJson.size() < 20000
        && (
             !('sourceDeviceId' in request.resource.data)
             || request.resource.data.sourceDeviceId == ''
           );
    }

    match /orgs/{orgId}/{document=**} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId)
        && document[0] != 'transfers'
        && document[0] != 'members'
        && document[0] != 'metadata'
        && document[0] != 'institutionSettings';
    }
  }
}
