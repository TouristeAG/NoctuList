<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Needed for BLE scanning on Android 6..11 (SDK <= 30). On Android 12+ (SDK 31+) we use
         BLUETOOTH_SCAN with neverForLocation instead, so location is not required. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <!-- For Gmail account access -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application
        android:name=".EventManagerApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.EventManagerApp"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Firebase Google Sign-In (Web OAuth loopback — same localhost URIs as Desktop). -->
        <activity
            android:name="com.eventmanager.app.data.remote.FirebaseGoogleSignInActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- White icon alias (default). Must not use MainActivity.* — tools resolve that as a non-existent inner class. -->
        <activity-alias
            android:name=".LauncherIconLight"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Black icon alias -->
        <activity-alias
            android:name=".LauncherIconDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_round_dark"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dark blue icon alias (legacy class name LauncherIconDeepBlue) -->
        <activity-alias
            android:name=".LauncherIconDeepBlue"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_deep_blue"
            android:roundIcon="@mipmap/ic_launcher_round_deep_blue"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dark turquoise icon alias (legacy class name LauncherIconBlueOcean) -->
        <activity-alias
            android:name=".LauncherIconBlueOcean"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_blue_ocean"
            android:roundIcon="@mipmap/ic_launcher_round_blue_ocean"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Brown icon alias (legacy class name LauncherIconBraun) -->
        <activity-alias
            android:name=".LauncherIconBraun"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_braun"
            android:roundIcon="@mipmap/ic_launcher_round_braun"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Crème / black icon alias (legacy class name LauncherIconPurple) -->
        <activity-alias
            android:name=".LauncherIconPurple"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_round_purple"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Violet Icon Alias (dark violet artwork) -->
        <activity-alias
            android:name=".LauncherIconViolet"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_violet"
            android:roundIcon="@mipmap/ic_launcher_round_violet"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconDarkLegacy"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark_legacy"
            android:roundIcon="@mipmap/ic_launcher_round_dark_legacy"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconLightLegacy"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light_legacy"
            android:roundIcon="@mipmap/ic_launcher_round_light_legacy"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconLightBlue"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light_blue"
            android:roundIcon="@mipmap/ic_launcher_round_light_blue"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconLightViolet"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light_violet"
            android:roundIcon="@mipmap/ic_launcher_round_light_violet"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconOrange"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_round_orange"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconPink"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_round_pink"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

